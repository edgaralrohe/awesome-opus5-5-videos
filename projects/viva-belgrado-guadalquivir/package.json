{
  "name": "viva-belgrado-fluye",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pieza animada 9:16 con la identidad visual de «Mientras el Guadalquivir fluye y fluye y fluye»",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "preview": "node scripts/serve.mjs",
    "render": "node scripts/render.mjs",
    "frames": "node scripts/render.mjs --frames 0,2,5,7,9,13,16,18,21,23,25,28",
    "preview:reel": "node scripts/serve.mjs",
    "frames:reel": "node scripts/render.mjs --page reel.html --frames 1,3,6,12.5,16,21,26,33,40,47,64,67,70,73,75.5",
    "render:reel": "node scripts/render.mjs --page reel.html",
    "frames:noche": "node scripts/render.mjs --page noche.html --frames 2,5,7,11,13,17,20,23.15,25.5,29,30.5,34.5",
    "render:noche": "node scripts/render.mjs --page noche.html",
    "chiptune": "node scripts/chiptune.mjs",
    "frames:cabanas": "node scripts/render.mjs --page cabanas.html --frames 3,5,8,10.5,12.2,13.5,17,20,21.2,22.6,27,33.6,40,46.4,52.8,59.2,62,65.5",
    "render:cabanas": "node scripts/chiptune.mjs && node scripts/render.mjs --page cabanas.html --audio out/cabanas.wav"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "5.2.8",
    "@fontsource/inter": "5.2.8"
  }
}
